# Optional. Raises GitHub REST API rate limits for public repositories.
GITHUB_TOKEN=

# Required to open pull requests. Needs Contents (read/write) + Pull requests (write)
# on the target repositories. Falls back to GITHUB_TOKEN when unset. Never commit it.
GITHUB_PR_TOKEN=

# PR flow kill switch. Keep "false" until you are ready to let the local demo push
# feature branches and open PRs. Hosted previews always refuse PRs.
CODEX_PILOT_ALLOW_PR=false
# PR head mode: "branch" pushes codex-pilot/issue-N-* to the same repo (needs write
# access); "fork" forks first, then opens a cross-fork PR (better for repos you don't own).
CODEX_PILOT_PR_MODE=branch

# Keep true (or unset) on the Codex-authenticated local demo machine.
# Set both flags to false for a hosted sample-only preview such as Vercel.
CODEX_PILOT_LIVE_RUNS=true
NEXT_PUBLIC_CODEX_PILOT_LIVE_RUNS=true

# Optional engine defaults (the Settings page overrides these per browser).
# CODEX_PILOT_PROVIDER=openai forces the OpenAI API engine for all runs.
# OPENAI_API_KEY fills in when the browser has no key saved. Never commit it.
#CODEX_PILOT_PROVIDER=local
#OPENAI_API_KEY=
